{
  "name": "deeclinic",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "npm run dev -w @deeclinic/web",
    "dev:api": "npm run dev -w @deeclinic/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vercel": "^66.1.0"
  },
  "overrides": {
    "path-to-regexp@^8.0.0": "^8.4.2"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2"
  }
}

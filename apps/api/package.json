{
  "name": "@deeclinic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e-auth": "tsx --env-file=../../.env scripts/e2e-auth.ts",
    "test:e2e-phase2": "tsx --env-file=../../.env scripts/e2e-phase2.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "smoke:vercel": "node scripts/smoke-vercel.mjs"
  },
  "dependencies": {
    "@deeclinic/shared": "*",
    "@supabase/supabase-js": "^2.119.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
